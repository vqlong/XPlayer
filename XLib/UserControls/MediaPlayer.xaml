<Window x:Class="XLib.UserControls.MediaPlayer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XLib"
        xmlns:localcontrol="clr-namespace:XLib.UserControls"
        xmlns:localconvert="clr-namespace:XLib.Converters"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="{Binding AppName}" 
        Height="800"
        MinHeight="500"
        Width="870"
        MinWidth="400"
        Background="{Binding BackgroundView.CurrentItem.Brush}"
        BorderBrush="{Binding BorderColorView.CurrentItem.Brush}"
        Style="{DynamicResource Window.CustomStyle}"
        RenderOptions.BitmapScalingMode="HighQuality" 
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        Name="player">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XLib;component/Resources/WindowStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/XLib;component/Resources/Converters.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/XLib;component/Resources/Brushes.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <CollectionViewSource x:Key="FileNamesView" Source="{Binding FileNames}"/>

            <BooleanToVisibilityConverter x:Key="BoolToVisi"/>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PeachGradient}"/>
                <Setter Property="Foreground" Value="{StaticResource BlueGradient}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PurpleGradient}"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding ActualWidth, Converter={StaticResource DivideTwo}}"
                                    Width="{TemplateBinding ActualWidth}"
                                    Height="{TemplateBinding ActualWidth}"
                                    ToolTipService.InitialShowDelay="0">
                                <Border.ToolTip>
                                    <ToolTip Content="{TemplateBinding Content}"/>
                                </Border.ToolTip>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PeachGradient}"/>
                                    <Setter Property="Background" Value="#ccf9ff"/>
                                    <Setter Property="BorderBrush" Value="#00acdf"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PeachGradient}"/>
                                    <Setter Property="Background" Value="#7ce8ff"/>
                                    <Setter Property="BorderBrush" Value="#0080bf"/>
                                </Trigger>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" Value="{StaticResource BlueGradient}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" Value="#FFF4F4F4"/>
                                    <Setter Property="BorderBrush" Value="#FFADB2B5"/>
                                    <Setter Property="TextElement.Foreground" Value="#FF838383"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RepeatButton.CustomStyle" TargetType="RepeatButton">
                <Setter Property="Background" Value="{StaticResource PeachGradient}"/>
                <Setter Property="Foreground" Value="{StaticResource BlueGradient}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PurpleGradient}"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding ActualWidth, Converter={StaticResource DivideTwo}}"
                                    Width="{TemplateBinding ActualWidth}"
                                    Height="{TemplateBinding ActualWidth}"
                                    ToolTipService.InitialShowDelay="0">
                                <Border.ToolTip>
                                    <ToolTip Content="{TemplateBinding Content}"/>
                                </Border.ToolTip>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PeachGradient}"/>
                                    <Setter Property="Background" Value="#ccf9ff"/>
                                    <Setter Property="BorderBrush" Value="#00acdf"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PeachGradient}"/>
                                    <Setter Property="Background" Value="#7ce8ff"/>
                                    <Setter Property="BorderBrush" Value="#0080bf"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" Value="#FFF4F4F4"/>
                                    <Setter Property="BorderBrush" Value="#FFADB2B5"/>
                                    <Setter Property="TextElement.Foreground" Value="#FF838383"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type localcontrol:SlideButton}">
                <Setter Property="Width" Value="80"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="5"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="WhiteSmoke"/>
            </Style>

            <SolidColorBrush x:Key="Menu.Static.Background" Color="#FFF0F0F0"/>
            <SolidColorBrush x:Key="Menu.Static.Border" Color="#FF999999"/>
            <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#FF212121"/>
            <SolidColorBrush x:Key="Menu.Static.Separator" Color="#FFD7D7D7"/>
            <SolidColorBrush x:Key="Menu.Disabled.Foreground" Color="#FF707070"/>
            <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="#3D26A0DA"/>
            <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="#FF26A0DA"/>
            <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="#3D26A0DA"/>
            <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="#FF26A0DA"/>
            <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Background" Color="#0A000000"/>
            <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Border" Color="#21000000"/>
            <Geometry x:Key="Checkmark">F1 M 10.0,1.2 L 4.7,9.1 L 4.5,9.1 L 0,5.2 L 1.3,3.5 L 4.3,6.1L 8.3,0 L 10.0,1.2 Z</Geometry>
            <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="{x:Type MenuItem}">
                <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                    <Grid Margin="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="22" SharedSizeGroup="MenuItemIconColumnGroup" Width="Auto"/>
                            <ColumnDefinition Width="13"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition SharedSizeGroup="MenuItemIGTColumnGroup" Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Icon" ContentSource="Icon" HorizontalAlignment="Center" Height="16" Margin="3" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center" Width="16"/>
                        <Border x:Name="GlyphPanel" Background="{StaticResource MenuItem.Selected.Background}" BorderBrush="{StaticResource MenuItem.Selected.Border}" BorderThickness="1" ClipToBounds="False" HorizontalAlignment="Center" Height="22" Margin="-1,0,0,0" VerticalAlignment="Center" Visibility="Hidden" Width="22">
                            <Path x:Name="Glyph" Data="{StaticResource Checkmark}" FlowDirection="LeftToRight" Fill="{StaticResource Menu.Static.Foreground}" Height="11" Width="10"/>
                        </Border>
                        <ContentPresenter x:Name="menuHeaderContainer" ContentSource="Header" Grid.Column="2" HorizontalAlignment="Stretch" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="menuGestureText" Grid.Column="3" Margin="{TemplateBinding Padding}" Opacity="0.7" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Icon" Value="{x:Null}">
                        <Setter Property="Visibility" TargetName="Icon" Value="Collapsed"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Visibility" TargetName="GlyphPanel" Value="Visible"/>
                        <Setter Property="Visibility" TargetName="Icon" Value="Collapsed"/>
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" TargetName="templateRoot" Value="{StaticResource MenuItem.Highlight.Background}"/>
                        <Setter Property="BorderBrush" TargetName="templateRoot" Value="{StaticResource MenuItem.Highlight.Border}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="TextElement.Foreground" TargetName="templateRoot" Value="{StaticResource Menu.Disabled.Foreground}"/>
                        <Setter Property="Fill" TargetName="Glyph" Value="{StaticResource Menu.Disabled.Foreground}"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsHighlighted" Value="True"/>
                            <Condition Property="IsEnabled" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" TargetName="templateRoot" Value="{StaticResource MenuItem.Highlight.Disabled.Background}"/>
                        <Setter Property="BorderBrush" TargetName="templateRoot" Value="{StaticResource MenuItem.Highlight.Disabled.Border}"/>
                    </MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="10 5 10 0" >
        <Grid DockPanel.Dock="Bottom">
            <localcontrol:XSlider Minimum="{Binding ElementName=sliderSeekBar, Path=Minimum}" 
                                  Maximum="{Binding ElementName=sliderSeekBar, Path=Maximum}" 
                           DecreaseButtonBackground="{StaticResource UncheckedGradient}" 
                                  IncreaseButtonBackground="Transparent"
                           Value="{Binding ElementName=sliderSeekBar, Path=Value}" 
                                  Mode="{Binding ElementName=sliderSeekBar, Path=Mode}" 
                                  TrackHeight="2" Height="2"
                           ShowMaxMin="Collapsed" 
                                  ShowValue="Collapsed"  
                                  Margin="-10 0 -10 0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding ElementName=txblPosition, Path=Text}"  />
                <localcontrol:Equalizer x:Name="statusEqualizer" 
                                        Mode="3"
                                        Width="30" 
                                        EqualizerWidth="30" 
                                        EqualizerHeight="10"
                                        Height="10"
                                        Status="{Binding ElementName=player, Path=Status}" 
                                        Margin="2 1 0 1"/>
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding ElementName=menuControls, Path=IsChecked, Converter={StaticResource BoolToVisi}}">
            <localcontrol:XSlider x:Name="sliderSeekBar" Mode="HorizontalSeekSlider" ValueChanged="sliderSeekBar_ValueChanged"
                           LargeChange="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Maximum, Converter={StaticResource DivideParameter}, ConverterParameter=100}"
                           Height="20" TrackHeight="20" ShowMaxMin="Collapsed" ShowValue="Collapsed" IsMoveToPointEnabled="True" ToolTipService.InitialShowDelay="0"
                           DecreaseButtonBackground="{StaticResource UncheckedGradient}" IncreaseButtonBackground="Transparent" ToolTip="{Binding ElementName=txblPosition, Path=Text}"  Margin="-10 0 -10 0"/>
            <TextBlock Name="txblPosition" Text="{Binding TextPosition}" HorizontalAlignment="Center" />
            <StackPanel HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{Binding Status, StringFormat={}Status: ({0})}"/>
                <TextBlock Text="{Binding IsRepeat, StringFormat={}IsRepeat: ({0})}"/>
                <TextBlock Text="{Binding IsShuffle, StringFormat={}IsShuffle: ({0})}"/>
                <TextBlock Text="{Binding ClockState, StringFormat={}ClockState: ({0})}"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Margin="0 0 0 0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Name="stplControlMedia">
                    <!--<Button Name="btnBrowse" Click="btnBrowse_Click" >Browse</Button>-->
                    <localcontrol:SlideButton x:Name="btnRepeat" Content="Repeat" IsChecked="{Binding ElementName=player, Path=IsRepeat, Converter={x:Static localconvert:BoolToBoolNullableConverter.Default}}">
                        <localcontrol:SlideButton.CheckedContent>
                            <Grid >
                                <Border Width="20" Height="20" BorderBrush="{StaticResource YellowGradient}" BorderThickness="2" CornerRadius="10" Margin="0 0 20 0">
                                    <TextBlock HorizontalAlignment="Center">1</TextBlock>
                                </Border>
                                <Polygon Points="17 11 19 8 21 11" Stroke="#FDA600"/>
                            </Grid>
                        </localcontrol:SlideButton.CheckedContent>
                        <localcontrol:SlideButton.UncheckedContent>
                            <Grid >
                                <Border Width="20" Height="20" BorderBrush="{StaticResource YellowGradient}" BorderThickness="2" CornerRadius="10" Margin="20 0 0 0">
                                    <TextBlock HorizontalAlignment="Center">0</TextBlock>
                                </Border>
                                <Polygon Points="39 11 41 8 42.8 11" Stroke="#FDA600" />
                            </Grid>
                        </localcontrol:SlideButton.UncheckedContent>
                    </localcontrol:SlideButton>
                    <RepeatButton x:Name="btnBackward" Style="{StaticResource RepeatButton.CustomStyle}" Command="Slider.DecreaseLarge" CommandTarget="{Binding ElementName=sliderSeekBar}">Backward</RepeatButton>
                    <Button Name="btnStop" Click="Button_ControlMedia">Stop</Button>
                    <Button Name="btnPlay" Click="Button_ControlMedia" IsEnabled="{Binding ElementName=lsvFileNames, Path=HasItems}">Play</Button>
                    <Button Name="btnPause" Click="Button_ControlMedia" Visibility="Collapsed">Pause</Button>
                    <Button Name="btnResume" Click="Button_ControlMedia" Visibility="Collapsed">Resume</Button>
                    <Button Name="btnNext" Click="btnNext_Click">Next</Button>
                    <RepeatButton x:Name="btnForward" Style="{StaticResource RepeatButton.CustomStyle}" Command="Slider.IncreaseLarge" CommandTarget="{Binding ElementName=sliderSeekBar}">Forward</RepeatButton>
                    <localcontrol:SlideButton x:Name="btnShuffle" Checked="btnShuffle_Checked" Unchecked="btnShuffle_Unchecked" Content="Shuffle" IsChecked="{Binding ElementName=player, Path=IsShuffle, Converter={x:Static localconvert:BoolToBoolNullableConverter.Default}}">
                        <localcontrol:SlideButton.CheckedContent>
                            <Grid Width="60" Height="20">
                                <Polyline Points="2 5 10 5 30 15 37 15 33 13.5 33 16.5 37 15" StrokeLineJoin="Round" StrokeStartLineCap="Round" Stroke="#FDA600" StrokeThickness="2"/>
                                <Polyline Points="2 15 10 15 30 5 37 5 33 3.5 33 6.5 37 5" StrokeLineJoin="Round" StrokeStartLineCap="Round" Stroke="{StaticResource UncheckedGradient}" StrokeThickness="2"/>
                            </Grid>
                        </localcontrol:SlideButton.CheckedContent>
                        <localcontrol:SlideButton.UncheckedContent>
                            <Grid Width="60" Height="20" >
                                <Polyline Points="22 5 30 5 50 15 57 15 53 13.5 53 16.5 57 15" StrokeLineJoin="Round" StrokeStartLineCap="Round" Stroke="{StaticResource YellowGradient}" StrokeThickness="2"/>
                            </Grid>
                        </localcontrol:SlideButton.UncheckedContent>
                    </localcontrol:SlideButton>
                    <Button Name="btnSeek" Visibility="Collapsed"/>

                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="btnPlay">
                            <BeginStoryboard Name="beginStoryboard">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.Target="{Binding ElementName=ellipseContextMenu}" 
                                                 Storyboard.TargetProperty="RenderTransform.Angle"
                                                 From="0"
                                                 To="360"
                                                 Duration="0:0:0.5"
                                                 RepeatBehavior="Forever"/>
                                    <MediaTimeline Storyboard.TargetName="media" 
                                               Source="{Binding ElementName=lsvFileNames, Path=SelectedItem}"
                                               CurrentTimeInvalidated="MediaTimeline_CurrentTimeInvalidated"
                                               Name="mediaTimeline"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="btnPause">
                            <PauseStoryboard BeginStoryboardName="beginStoryboard"/>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="btnResume">
                            <ResumeStoryboard BeginStoryboardName="beginStoryboard"/>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="btnStop">
                            <StopStoryboard BeginStoryboardName="beginStoryboard"/>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="btnSeek">
                            <SeekStoryboard x:Name="seekMedia" BeginStoryboardName="beginStoryboard"/>
                        </EventTrigger>
                    </StackPanel.Triggers>
                </StackPanel>
            </ScrollViewer>
            <localcontrol:XSlider x:Name="sliderVolume" IsMoveToPointEnabled="True" Margin="0 5 0 0" Minimum="0" Maximum="100" Value="50" Unit="%" TickFrequency="25" TickFill="DarkOrchid" 
                           Background="{StaticResource AzureGradient}" BorderBrush="Navy" BorderThickness="1" Height="25" TickPlacement="None" TickHeight="4" ThumbOffset="-4.5" ShowThumbLine="Collapsed" ShowMaxMin="Collapsed" TrackHeight="10" Foreground="Tomato" 
                           ValueForeground="BlueViolet" DecreaseButtonBackground="{StaticResource PeachGradient}" IncreaseButtonBackground="#EDFFFD" ThumbBackground="{StaticResource PurpleGradient}"/>
            <Expander Margin="0 10 0 0" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PlaylistName}" />
                        <TextBlock Text="{Binding Path=FileNames.Count, StringFormat={} ({0})}" />
                    </StackPanel>
                </Expander.Header>
                <Border BorderBrush="Navy" BorderThickness="1" Margin="-1 0 -1 0">
                    <StackPanel>
                        <ScrollViewer Name="svFileNames" Height="200" PreviewMouseWheel="svFileNames_PreviewMouseWheel" >
                            <ListView Name="lsvFileNames" ItemsSource="{Binding Source={StaticResource FileNamesView}}" AllowDrop="True" Drop="lsvFileNames_Drop" IsSynchronizedWithCurrentItem="True" BorderThickness="0" MouseDoubleClick="lsvFileNames_MouseDoubleClick" >
                                <ListView.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="DimGray"/>
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="#" DisplayMemberBinding="{Binding Converter={x:Static localconvert:PathToIndexConverter.Default}, ConverterParameter={StaticResource FileNamesView}}"/>
                                        <GridViewColumn Header="File" DisplayMemberBinding="{Binding Converter={x:Static localconvert:PathToFilenameConverter.Default}}"/>
                                    </GridView>
                                </ListView.View>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Play" Click="MenuItem_Play" IsEnabled="{Binding Path=HasItems}">
                                            <MenuItem.Icon>
                                                <Border>
                                                    <Border.Background>
                                                        <DrawingBrush Stretch="None">
                                                            <DrawingBrush.Drawing>
                                                                <GeometryDrawing Brush="LimeGreen">
                                                                    <GeometryDrawing.Geometry>
                                                                        <Geometry>M 0 0 L 0 12 10 6 Z</Geometry>
                                                                    </GeometryDrawing.Geometry>
                                                                </GeometryDrawing>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Border.Background>
                                                </Border>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open" Click="MenuItem_Open">
                                            <MenuItem.Icon>
                                                <Border>
                                                    <Border.Background>
                                                        <DrawingBrush Stretch="None">
                                                            <DrawingBrush.Drawing>
                                                                <GeometryDrawing >
                                                                    <GeometryDrawing.Geometry>
                                                                        <EllipseGeometry Center="5 5" RadiusX="5" RadiusY="5"/>
                                                                    </GeometryDrawing.Geometry>
                                                                    <GeometryDrawing.Pen>
                                                                        <Pen Brush="Tomato" Thickness="2"/>
                                                                    </GeometryDrawing.Pen>
                                                                </GeometryDrawing>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Border.Background>
                                                </Border>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Add to Playlist" Click="MenuItem_AddToPlaylist">
                                            <MenuItem.Icon>
                                                <Border>
                                                    <Border.Background>
                                                        <DrawingBrush Stretch="None">
                                                            <DrawingBrush.Drawing>
                                                                <GeometryDrawing >
                                                                    <GeometryDrawing.Geometry>
                                                                        <GeometryGroup>
                                                                            <LineGeometry StartPoint="0 5" EndPoint="10 5"/>
                                                                            <LineGeometry StartPoint="5 0" EndPoint="5 10"/>
                                                                        </GeometryGroup>
                                                                    </GeometryDrawing.Geometry>
                                                                    <GeometryDrawing.Pen>
                                                                        <Pen Brush="LimeGreen" Thickness="2"/>
                                                                    </GeometryDrawing.Pen>
                                                                </GeometryDrawing>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Border.Background>
                                                </Border>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Remove from Playlist" Click="MenuItem_RemoveFromPlaylist">
                                            <MenuItem.Icon>
                                                <Border>
                                                    <Border.Background>
                                                        <DrawingBrush Stretch="None">
                                                            <DrawingBrush.Drawing>
                                                                <GeometryDrawing >
                                                                    <GeometryDrawing.Geometry>
                                                                        <LineGeometry StartPoint="0 5" EndPoint="10 5"/>
                                                                    </GeometryDrawing.Geometry>
                                                                    <GeometryDrawing.Pen>
                                                                        <Pen Brush="Crimson" Thickness="2"/>
                                                                    </GeometryDrawing.Pen>
                                                                </GeometryDrawing>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Border.Background>
                                                </Border>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Clear Playlist" Click="MenuItem_ClearPlaylist">
                                            <MenuItem.Icon>
                                                <Border>
                                                    <Border.Background>
                                                        <DrawingBrush Stretch="None">
                                                            <DrawingBrush.Drawing>
                                                                <GeometryDrawing >
                                                                    <GeometryDrawing.Geometry>
                                                                        <GeometryGroup>
                                                                            <LineGeometry StartPoint="0 0" EndPoint="10 10"/>
                                                                            <LineGeometry StartPoint="0 10" EndPoint="10 0"/>
                                                                        </GeometryGroup>
                                                                    </GeometryDrawing.Geometry>
                                                                    <GeometryDrawing.Pen>
                                                                        <Pen Brush="BlueViolet" Thickness="2"/>
                                                                    </GeometryDrawing.Pen>
                                                                </GeometryDrawing>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Border.Background>
                                                </Border>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open Playlist" Click="MenuItem_OpenPlaylist">
                                            <MenuItem.Icon>
                                                <Border>
                                                    <Border.Background>
                                                        <DrawingBrush Stretch="Uniform">
                                                            <DrawingBrush.Drawing>
                                                                <GeometryDrawing Brush="{StaticResource BlueGradient}">
                                                                    <GeometryDrawing.Geometry>
                                                                        <Geometry>M14,2L20,8V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V4A2,2 0 0,1 6,2H14M18,20V9H13V4H6V20H18M13,10V12H11V17A2,2 0 0,1 9,19A2,2 0 0,1 7,17A2,2 0 0,1 9,15C9.4,15 9.7,15.1 10,15.3V10H13Z</Geometry>
                                                                    </GeometryDrawing.Geometry>
                                                                </GeometryDrawing>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Border.Background>
                                                </Border>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Save Playlist" Click="MenuItem_SavePlaylist">
                                            <MenuItem.Icon>
                                                <Border>
                                                    <Border.Background>
                                                        <DrawingBrush Stretch="Uniform">
                                                            <DrawingBrush.Drawing>
                                                                <GeometryDrawing Brush="{StaticResource BlueGradient}">
                                                                    <GeometryDrawing.Geometry>
                                                                        <Geometry>M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z</Geometry>
                                                                    </GeometryDrawing.Geometry>
                                                                </GeometryDrawing>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Border.Background>
                                                </Border>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Default media path">
                                            <MenuItem StaysOpenOnClick="True">
                                                <MenuItem.Header>
                                                    <TextBox x:Name="txbDefaultPath" Background="Transparent" BorderThickness="0">J:\My Music\Nhac hoa</TextBox>
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </MenuItem>

                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>
                        </ScrollViewer>
                        <TextBox Text="Search from Playlist" Foreground="Gray" TextChanged="TextBox_TextChanged" GotMouseCapture="TextBox_GotMouseCapture" LostFocus="TextBox_LostFocus"/>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>

        <Border Background="Black" BorderBrush="Navy" BorderThickness="1">
            <Grid x:Name="gridMedia" >
                <Canvas x:Name="canvasTitle" >
                    <TextBlock x:Name="txblTitle" 
                               Canvas.Left="20" 
                               Canvas.Top="-35"
                               FontSize="16" 
                               Foreground="{Binding BorderBrush}" />
                    <TextBlock x:Name="txblTitle1" 
                               Canvas.Left="{Binding ActualWidth}" 
                               Canvas.Top="-35" 
                               FontSize="16" 
                               Foreground="{Binding BorderBrush}" 
                               Text="{Binding ElementName=txblTitle, Path=Text}"/>
                </Canvas>
                <!-- Status="{Binding Status}" éo binding được -->
                <localcontrol:Equalizer x:Name="equalizer" 
                                        ShowMode="True" 
                                        EqualizerWidth="300"
                                        Height="{Binding ElementName=gridMedia, Path=ActualHeight}"
                                        EqualizerHeight="200"                                        
                                        Status="{Binding ElementName=player, Path=Status}" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                <MediaElement x:Name="gifPlayer" 
                              LoadedBehavior="Manual" 
                              UnloadedBehavior="Manual" 
                              MediaEnded="gifPlayer_MediaEnded" 
                              Visibility="Hidden"/>
                <MediaElement x:Name="media" 
                              Volume="{Binding ElementName=sliderVolume, Path=Value, Converter={StaticResource DivideParameter}, ConverterParameter=100}" 
                              MediaOpened="media_MediaOpened" 
                              MediaFailed="media_MediaFailed"/>
            </Grid>
        </Border>
    </DockPanel>
    <Window.ContextMenu>
        <ContextMenu >
            <MenuItem Header="Next Equalizer" IsEnabled="{Binding Source={x:Reference menuEqualizer}, Path=IsChecked}" Click="MenuItem_NextEqualizer" >
                <MenuItem.Icon>
                    <Canvas>
                        <Ellipse Name="ellipseContextMenu" Canvas.Left="-2" Canvas.Top="-3" Width="22" Height="22" StrokeThickness="0" Stroke="Navy" RenderTransformOrigin="0.5 0.5">
                            <Ellipse.Fill>
                                <DrawingBrush Stretch="Uniform">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="Crimson">
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="200 100" RadiusX="30" RadiusY="100"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="Tomato">
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="200 300" RadiusX="30" RadiusY="100"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="YellowGreen">
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="100 200" RadiusX="100" RadiusY="30"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="LimeGreen">
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="300 200" RadiusX="100" RadiusY="30"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="Yellow">
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="200 200" RadiusX="30" RadiusY="30"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="menuEqualizer" Header="Equalizer" IsCheckable="True" IsChecked="True"/>
            <Separator/>
            <MenuItem Header="Play" Click="MenuItem_ControlMedia" IsEnabled="{Binding Path=HasItems}">
                <MenuItem.Icon>
                    <Border >
                        <Border.Background>
                            <VisualBrush Visual="{x:Reference Name=statusEqualizer}" />
                        </Border.Background>
                    </Border>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Pause" Click="MenuItem_ControlMedia">
                <MenuItem.Icon>
                    <Border>
                        <Border.Background>
                            <DrawingBrush Stretch="None">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing >
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <LineGeometry StartPoint="0 0" EndPoint="0 10"/>
                                                <LineGeometry StartPoint="6 0" EndPoint="6 10"/>
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="Gray" Thickness="2"/>
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                    </Border>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Resume" Click="MenuItem_ControlMedia">
                <MenuItem.Icon>
                    <Border>
                        <Border.Background>
                            <DrawingBrush Stretch="None">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="LimeGreen">
                                        <GeometryDrawing.Geometry>
                                            <Geometry>M 0 0 L 0 12 10 6 Z</Geometry>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                    </Border>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Stop" Click="MenuItem_ControlMedia">
                <MenuItem.Icon>
                    <Border>
                        <Border.Background>
                            <DrawingBrush Stretch="None">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="Crimson">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0 0 10 10"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                    </Border>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Repeat" IsCheckable="True"  IsChecked="{Binding Path=IsRepeat}"/>
            <MenuItem Header="Shuffle" IsCheckable="True" IsChecked="{Binding Path=IsShuffle}"/>
            <MenuItem Header="Next" Click="MenuItem_ControlMedia">
                <MenuItem.Icon>
                    <Border>
                        <Border.Background>
                            <DrawingBrush Stretch="None">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="LimeGreen">
                                        <GeometryDrawing.Geometry>
                                            <Geometry>M 2 2 L 2 10 8 6 Z M 12 0 L 12 12</Geometry>
                                        </GeometryDrawing.Geometry>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="LimeGreen" Thickness="2"/>
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                    </Border>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem x:Name="menuControls" Header="Controls" IsChecked="True" IsCheckable="True"/>
            <MenuItem Header="Setting">
                <MenuItem Template="{StaticResource SubmenuItemTemplate}">
                    <MenuItem.Header>
                        <DockPanel Width="225">
                            <TextBlock Width="70" VerticalAlignment="Center" Foreground="#FF212121" DockPanel.Dock="Left">Background</TextBlock>
                            <ComboBox Name="cbColors"
                                  ItemsSource="{Binding BackgroundView}"
                                  IsSynchronizedWithCurrentItem="True">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="18" Fill="{Binding Brush}" Margin="0 0 5 0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        </DockPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Template="{StaticResource SubmenuItemTemplate}">
                    <MenuItem.Header>
                        <DockPanel Width="225">
                            <TextBlock Width="70" VerticalAlignment="Center" Foreground="#FF212121" DockPanel.Dock="Left">Border</TextBlock>
                            <ComboBox Name="cbColorsx"
                                  ItemsSource="{Binding BorderColorView}"
                                  IsSynchronizedWithCurrentItem="True">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="18" Fill="{Binding Brush}" Margin="0 0 5 0"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
</Window>
